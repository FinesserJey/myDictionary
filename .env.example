# Server-only Langbly key. Do not prefix this with VITE_ and do not commit .env.
LANGBLY_API_KEY=

# Optional server-only fallback key for LibreTranslate.
LIBRETRANSLATE_API_KEY=

# Hosting providers set PORT automatically. Use this for local development.
TRANSLATION_PROXY_PORT=8787
PROXY_ALLOWED_ORIGIN=http://localhost:5173
